# Copy this file to `.env` and adjust as needed.

# MongoDB connection string.
# Local install (default):
MONGODB_URI=mongodb://127.0.0.1:27017/mc_paradise
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mc_paradise?retryWrites=true&w=majority

# API port
PORT=4500

# Seeded only on the very first run (when the admin does not exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# ---------------------------------------------------------------
# EMAIL (SMTP)
# ---------------------------------------------------------------
# Used to email the guest a booking confirmation and to alert staff
# about new bookings. Leave SMTP_HOST empty to disable email entirely —
# the app runs normally and simply logs that it skipped the message.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=mcparadise2025@gmail.com
SMTP_PASSWORD=loud ttff rndv ofoi
# Set true when an antivirus scans your mail over TLS and presents its
# own certificate (Avast, Kaspersky, ESET…). Leave false in production.
SMTP_TLS_RELAXED=false
# The "from" address guests see. Defaults to SMTP_USER when empty.
MAIL_FROM="MC Paradise Apartment <no-reply@mc-paradiseapartment.com>"
# Where the site lives, used for links inside emails.
PUBLIC_SITE_URL=http://localhost:4000
# The front-desk number quoted in the guest's confirmation email.
SUPPORT_PHONE=+250 788 382 569

# ---------------------------------------------------------------
# IMAGE UPLOADS (Cloudinary)
# ---------------------------------------------------------------
# Customer ID/passport photos and room photos are uploaded to
# Cloudinary. The backend SIGNS each upload, so the API secret stays
# on the server and is never exposed to the browser. Find these three
# values on your Cloudinary dashboard (Dashboard → Product Environment
# Credentials). Leave them empty to disable uploads — the rest of the
# app keeps working and the upload buttons explain that Cloudinary is
# not configured yet.
CLOUDINARY_CLOUD_NAME= l9xjthim
CLOUDINARY_API_KEY=924953334176873
CLOUDINARY_API_SECRET=KlcOwwhTDZGudTxGn3XjKcDtb9w
# Optional folder prefix; every upload lands in `<folder>/<purpose>`.
CLOUDINARY_FOLDER=mc-paradise
